{
  "midl": "1.0.0",
  "meta": {
    "title": "Dashboard",
    "description": "At-a-glance quad: apparent wind rose, SOG, depth and house battery state of charge.",
    "useCase": "Home screen: the four numbers a skipper checks first.",
    "tags": [
      "builtin"
    ]
  },
  "screens": [
    {
      "id": "dashboard",
      "title": "Dashboard",
      "elements": {
        "wind": {
          "type": "windrose",
          "name": "WIND",
          "bindings": {
            "value": {
              "kind": "signalk",
              "path": "environment.wind.speedApparent"
            },
            "dir": {
              "kind": "signalk",
              "path": "environment.wind.angleApparent"
            }
          },
          "format": {
            "unit": "kn",
            "decimals": 1
          },
          "style": {
            "color": "warn"
          },
          "zoom": "wind"
        },
        "sog": {
          "type": "single-value",
          "name": "SOG",
          "bindings": {
            "value": {
              "kind": "signalk",
              "path": "navigation.speedOverGround"
            }
          },
          "format": {
            "unit": "kn",
            "decimals": 1
          },
          "style": {
            "color": "accent"
          },
          "zoom": "nav"
        },
        "depth": {
          "type": "single-value",
          "name": "DEPTH",
          "bindings": {
            "value": {
              "kind": "signalk",
              "path": "environment.depth.belowTransducer"
            }
          },
          "format": {
            "unit": "m",
            "decimals": 1
          },
          "style": {
            "color": "good"
          },
          "zoom": "depth"
        },
        "batt": {
          "type": "bar",
          "name": "BATT",
          "bindings": {
            "value": {
              "kind": "signalk",
              "path": "electrical.batteries.house.stateOfCharge"
            }
          },
          "format": {
            "unit": "%",
            "decimals": 0
          },
          "style": {
            "color": "good",
            "range": [
              0,
              100
            ]
          },
          "zoom": "status"
        }
      },
      "layout": {
        "rows": 2,
        "cols": 2,
        "cells": [
          {
            "element": "wind"
          },
          {
            "element": "sog"
          },
          {
            "element": "depth"
          },
          {
            "element": "batt"
          }
        ]
      },
      "variants": [
        {
          "class": "square-480",
          "layout": {
            "rows": 2,
            "cols": 2,
            "cells": [
              {
                "element": "wind"
              },
              {
                "element": "sog"
              },
              {
                "element": "depth"
              },
              {
                "element": "batt"
              }
            ]
          }
        },
        {
          "class": "landscape-800x480",
          "layout": {
            "rows": 2,
            "cols": 2,
            "cells": [
              {
                "element": "wind"
              },
              {
                "element": "sog"
              },
              {
                "element": "depth"
              },
              {
                "element": "batt"
              }
            ]
          }
        },
        {
          "class": "landscape-1024x600",
          "layout": {
            "rows": 2,
            "cols": 2,
            "cells": [
              {
                "element": "wind"
              },
              {
                "element": "sog"
              },
              {
                "element": "depth"
              },
              {
                "element": "batt"
              }
            ]
          }
        }
      ]
    }
  ]
}
