{
  "midl": "1.0.0",
  "meta": {
    "title": "Steering",
    "description": "Steering quad: heading compass with CTS, XTE, VMG and rudder, over a course-adjust row.",
    "useCase": "Hand or autopilot steering along a course.",
    "tags": [
      "builtin"
    ]
  },
  "screens": [
    {
      "id": "steering",
      "title": "Steering",
      "elements": {
        "hdg": {
          "type": "compass",
          "name": "HDG / CTS",
          "bindings": {
            "value": {
              "kind": "signalk",
              "path": "navigation.headingTrue"
            },
            "dir": {
              "kind": "signalk",
              "path": "navigation.headingTrue"
            }
          },
          "style": {
            "color": "accent"
          },
          "markers": [
            {
              "dir": {
                "kind": "signalk",
                "path": "navigation.courseRhumbline.bearingTrackTrue"
              },
              "glyph": "triangle",
              "color": "good"
            }
          ]
        },
        "xte": {
          "type": "single-value",
          "name": "XTE",
          "bindings": {
            "value": {
              "kind": "signalk",
              "path": "navigation.courseRhumbline.crossTrackError"
            }
          },
          "format": {
            "unit": "nm",
            "decimals": 2,
            "side": true
          },
          "style": {
            "color": "warn"
          }
        },
        "vmg": {
          "type": "single-value",
          "name": "VMG",
          "bindings": {
            "value": {
              "kind": "signalk",
              "path": "navigation.courseRhumbline.velocityMadeGood"
            }
          },
          "format": {
            "unit": "kn",
            "decimals": 1
          },
          "style": {
            "color": "good"
          }
        },
        "rudder": {
          "type": "single-value",
          "name": "RUDDER",
          "bindings": {
            "value": {
              "kind": "signalk",
              "path": "steering.rudderAngle"
            }
          },
          "format": {
            "unit": "deg",
            "decimals": 0,
            "side": true
          },
          "style": {
            "color": "fg"
          }
        },
        "m10": {
          "type": "button",
          "name": "-10",
          "meta": {
            "description": "Adjust the autopilot target heading by -10 degrees."
          },
          "action": {
            "kind": "command",
            "target": "autopilot heading -10"
          }
        },
        "m1": {
          "type": "button",
          "name": "-1",
          "meta": {
            "description": "Adjust the autopilot target heading by -1 degrees."
          },
          "action": {
            "kind": "command",
            "target": "autopilot heading -1"
          }
        },
        "p1": {
          "type": "button",
          "name": "+1",
          "meta": {
            "description": "Adjust the autopilot target heading by +1 degrees."
          },
          "action": {
            "kind": "command",
            "target": "autopilot heading 1"
          }
        },
        "p10": {
          "type": "button",
          "name": "+10",
          "meta": {
            "description": "Adjust the autopilot target heading by +10 degrees."
          },
          "action": {
            "kind": "command",
            "target": "autopilot heading 10"
          }
        }
      },
      "layout": {
        "flow": "col",
        "children": [
          {
            "rows": 2,
            "cols": 2,
            "cells": [
              {
                "element": "hdg"
              },
              {
                "element": "xte"
              },
              {
                "element": "vmg"
              },
              {
                "element": "rudder"
              }
            ]
          },
          {
            "flow": "row",
            "children": [
              {
                "element": "m10"
              },
              {
                "element": "m1"
              },
              {
                "element": "p1"
              },
              {
                "element": "p10"
              }
            ]
          }
        ],
        "weights": [
          5,
          1
        ]
      },
      "variants": [
        {
          "class": "square-480",
          "layout": {
            "flow": "col",
            "children": [
              {
                "rows": 2,
                "cols": 2,
                "cells": [
                  {
                    "element": "hdg"
                  },
                  {
                    "element": "xte"
                  },
                  {
                    "element": "vmg"
                  },
                  {
                    "element": "rudder"
                  }
                ]
              },
              {
                "flow": "row",
                "children": [
                  {
                    "element": "m10"
                  },
                  {
                    "element": "m1"
                  },
                  {
                    "element": "p1"
                  },
                  {
                    "element": "p10"
                  }
                ]
              }
            ],
            "weights": [
              5,
              1
            ]
          }
        },
        {
          "class": "landscape-800x480",
          "layout": {
            "flow": "col",
            "children": [
              {
                "rows": 2,
                "cols": 2,
                "cells": [
                  {
                    "element": "hdg"
                  },
                  {
                    "element": "xte"
                  },
                  {
                    "element": "vmg"
                  },
                  {
                    "element": "rudder"
                  }
                ]
              },
              {
                "flow": "row",
                "children": [
                  {
                    "element": "m1"
                  },
                  {
                    "element": "p1"
                  }
                ]
              }
            ],
            "weights": [
              5,
              1
            ]
          }
        },
        {
          "class": "landscape-1024x600",
          "layout": {
            "flow": "col",
            "children": [
              {
                "rows": 2,
                "cols": 2,
                "cells": [
                  {
                    "element": "hdg"
                  },
                  {
                    "element": "xte"
                  },
                  {
                    "element": "vmg"
                  },
                  {
                    "element": "rudder"
                  }
                ]
              },
              {
                "flow": "row",
                "children": [
                  {
                    "element": "m1"
                  },
                  {
                    "element": "p1"
                  }
                ]
              }
            ],
            "weights": [
              5,
              1
            ]
          }
        }
      ]
    }
  ]
}
