{
  "midl": "1.0.0",
  "meta": {
    "title": "Wind Steer",
    "description": "Heading-up wind-steering dial with laylines, over course-adjust and tack/gybe buttons.",
    "useCase": "Steering to the wind under autopilot: trim, tack and gybe.",
    "tags": [
      "builtin"
    ]
  },
  "screens": [
    {
      "id": "wind_steer",
      "title": "Wind Steer",
      "elements": {
        "steer": {
          "type": "windsteer",
          "name": "WIND STEER",
          "meta": {
            "description": "Heading-up wind-steering dial with no-go/target laylines, HDG/COG/CTS/TWD markers and wind tiles."
          },
          "bindings": {
            "value": {
              "kind": "signalk",
              "path": "environment.wind.speedApparent"
            },
            "dir": {
              "kind": "signalk",
              "path": "environment.wind.angleApparent"
            }
          },
          "format": {
            "unit": "kn",
            "decimals": 1
          },
          "style": {
            "color": "warn"
          }
        },
        "m10": {
          "type": "button",
          "name": "-10",
          "meta": {
            "description": "Adjust the autopilot target heading by -10 degrees."
          },
          "action": {
            "kind": "command",
            "target": "autopilot heading -10"
          }
        },
        "m1": {
          "type": "button",
          "name": "-1",
          "meta": {
            "description": "Adjust the autopilot target heading by -1 degrees."
          },
          "action": {
            "kind": "command",
            "target": "autopilot heading -1"
          }
        },
        "p1": {
          "type": "button",
          "name": "+1",
          "meta": {
            "description": "Adjust the autopilot target heading by +1 degrees."
          },
          "action": {
            "kind": "command",
            "target": "autopilot heading 1"
          }
        },
        "p10": {
          "type": "button",
          "name": "+10",
          "meta": {
            "description": "Adjust the autopilot target heading by +10 degrees."
          },
          "action": {
            "kind": "command",
            "target": "autopilot heading 10"
          }
        },
        "tack": {
          "type": "button",
          "name": "TACK",
          "meta": {
            "description": "Turn onto the opposite tack (mirror the true wind angle)."
          },
          "action": {
            "kind": "command",
            "target": "autopilot tack"
          }
        },
        "gybe": {
          "type": "button",
          "name": "GYBE",
          "meta": {
            "description": "Gybe onto the opposite gybe (mirror the true wind angle through the stern)."
          },
          "action": {
            "kind": "command",
            "target": "autopilot gybe"
          }
        }
      },
      "layout": {
        "flow": "col",
        "children": [
          {
            "element": "steer"
          },
          {
            "flow": "row",
            "children": [
              {
                "element": "m10"
              },
              {
                "element": "m1"
              },
              {
                "element": "p1"
              },
              {
                "element": "p10"
              },
              {
                "element": "tack"
              },
              {
                "element": "gybe"
              }
            ]
          }
        ],
        "weights": [
          3,
          1
        ]
      },
      "variants": [
        {
          "class": "square-480",
          "layout": {
            "flow": "col",
            "children": [
              {
                "element": "steer"
              },
              {
                "flow": "row",
                "children": [
                  {
                    "element": "m10"
                  },
                  {
                    "element": "m1"
                  },
                  {
                    "element": "p1"
                  },
                  {
                    "element": "p10"
                  },
                  {
                    "element": "tack"
                  },
                  {
                    "element": "gybe"
                  }
                ]
              }
            ],
            "weights": [
              3,
              1
            ]
          }
        },
        {
          "class": "landscape-800x480",
          "layout": {
            "flow": "col",
            "children": [
              {
                "element": "steer"
              },
              {
                "flow": "row",
                "children": [
                  {
                    "element": "m1"
                  },
                  {
                    "element": "p1"
                  },
                  {
                    "element": "tack"
                  },
                  {
                    "element": "gybe"
                  }
                ]
              }
            ],
            "weights": [
              3,
              1
            ]
          }
        },
        {
          "class": "landscape-1024x600",
          "layout": {
            "flow": "col",
            "children": [
              {
                "element": "steer"
              },
              {
                "flow": "row",
                "children": [
                  {
                    "element": "m1"
                  },
                  {
                    "element": "p1"
                  },
                  {
                    "element": "tack"
                  },
                  {
                    "element": "gybe"
                  }
                ]
              }
            ],
            "weights": [
              3,
              1
            ]
          }
        }
      ]
    }
  ]
}
