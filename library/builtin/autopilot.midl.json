{
  "midl": "1.0.0",
  "meta": {
    "title": "Autopilot",
    "description": "Glass-cockpit autopilot HUD over a course-adjust button row.",
    "useCase": "Engaging the autopilot and adjusting its course.",
    "tags": [
      "builtin"
    ]
  },
  "screens": [
    {
      "id": "autopilot",
      "title": "Autopilot",
      "elements": {
        "ap": {
          "type": "autopilot",
          "name": "AUTOPILOT",
          "meta": {
            "description": "Autopilot HUD: heading compass with HDG/COG/CTS/target markers, mode badge, engage chip, XTE and tiles."
          },
          "bindings": {
            "value": {
              "kind": "signalk",
              "path": "steering.autopilot.state"
            }
          },
          "style": {
            "color": "good"
          }
        },
        "m10": {
          "type": "button",
          "name": "-10",
          "meta": {
            "description": "Adjust the autopilot target heading by -10 degrees."
          },
          "action": {
            "kind": "command",
            "target": "autopilot heading -10"
          }
        },
        "m1": {
          "type": "button",
          "name": "-1",
          "meta": {
            "description": "Adjust the autopilot target heading by -1 degrees."
          },
          "action": {
            "kind": "command",
            "target": "autopilot heading -1"
          }
        },
        "p1": {
          "type": "button",
          "name": "+1",
          "meta": {
            "description": "Adjust the autopilot target heading by +1 degrees."
          },
          "action": {
            "kind": "command",
            "target": "autopilot heading 1"
          }
        },
        "p10": {
          "type": "button",
          "name": "+10",
          "meta": {
            "description": "Adjust the autopilot target heading by +10 degrees."
          },
          "action": {
            "kind": "command",
            "target": "autopilot heading 10"
          }
        }
      },
      "layout": {
        "flow": "col",
        "children": [
          {
            "element": "ap"
          },
          {
            "flow": "row",
            "children": [
              {
                "element": "m10"
              },
              {
                "element": "m1"
              },
              {
                "element": "p1"
              },
              {
                "element": "p10"
              }
            ]
          }
        ],
        "weights": [
          4,
          1
        ]
      },
      "variants": [
        {
          "class": "square-480",
